{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Context Capsule manifest v3",
  "type": "object",
  "required": [
    "schema", "schema_version", "repository", "authoritative_branch", "discovery_branch",
    "branch_mode", "entrypoint", "capsule_metadata", "protocol", "latest_handoff",
    "project", "current", "rules", "decisions", "dialogues", "history", "runtime", "sync_policy"
  ],
  "properties": {
    "schema": {"const": "context-capsule-manifest"},
    "schema_version": {"const": 3},
    "repository": {"type": "string", "pattern": "^[^/]+/[^/]+$"},
    "authoritative_branch": {"type": "string", "minLength": 1},
    "discovery_branch": {"type": "string", "minLength": 1},
    "branch_mode": {"enum": ["single", "redirect"]},
    "entrypoint": {"type": "string"},
    "capsule_metadata": {"type": "string"},
    "protocol": {"type": "string"},
    "latest_handoff": {"type": "string"},
    "project": {
      "type": "object",
      "required": ["identity", "goals", "architecture", "constraints"],
      "additionalProperties": true
    },
    "current": {
      "type": "object",
      "required": ["state", "blockers", "next"],
      "additionalProperties": true
    },
    "rules": {"type": "array", "items": {"type": "string"}},
    "decisions": {"type": "array", "items": {"type": "string"}},
    "dialogues": {"type": "array", "items": {"type": "string"}},
    "history": {"type": "array", "items": {"type": "string"}},
    "runtime": {"type": "object", "additionalProperties": true},
    "sync_policy": {"type": "object", "additionalProperties": true}
  },
  "additionalProperties": true
}
