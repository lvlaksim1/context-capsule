{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://context-capsule.local/schemas/capsule.schema.json",
  "title": "Context Capsule installation metadata",
  "type": "object",
  "required": [
    "schema",
    "version",
    "source",
    "installed_at",
    "repository",
    "update_policy",
    "managed_files"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {"const": "context-capsule"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "source": {"type": "string", "minLength": 1},
    "installed_at": {"type": "string", "format": "date"},
    "repository": {"type": "string", "pattern": "^[^/\\s]+/[^/\\s]+$"},
    "update_policy": {"enum": ["manual"], "default": "manual"},
    "adopted_from": {"type": "string", "minLength": 1},
    "managed_files": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      }
    }
  }
}
